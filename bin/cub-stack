#!/usr/bin/env node
const OWN_HELP = [];
// --help is never a name: it prints the usage and exits 0.
if (process.argv.slice(3).some((arg) => arg === "--help" || arg === "-h") && !OWN_HELP.includes(process.argv[2])) process.argv.length = 2;
const implementation = process.argv[2] === "compose" ? "stack-compose.mjs" : "stack.mjs";
import(new URL(`../lib/${implementation}`, import.meta.url).href).catch((error) => {
  if (process.argv[2] === "compose" && process.argv.slice(3).includes("--json")) {
    console.log(JSON.stringify({ kind: "CatalogRetainedCompositionError", code: error.code ?? "invalid_arguments", message: error.message ?? "compose failed", actions: error.actions ?? ["inspect", "repair"] }));
    process.exit(error.exitCode ?? 1);
    return;
  }
  // A failure reads as one line, never a stack trace.
  const text = String(error.stderr ?? error.message).trim().split("\n").filter(Boolean).pop() ?? "unknown error";
  console.error(text.startsWith("Failed") ? text : `Failed: ${text}`);
  process.exit(error.exitCode ?? 1);
});
