#!/usr/bin/env node
const OWN_HELP = ["match"];
// --help is never a name: it prints the usage and exits 0.
if (process.argv.slice(3).some((arg) => arg === "--help" || arg === "-h") && !OWN_HELP.includes(process.argv[2])) process.argv.length = 2;
(process.argv[2] === "match"
  ? import(new URL("../lib/app-match.mjs", import.meta.url).href).then(({ runMatch }) => { process.exitCode = runMatch(process.argv.slice(3)); })
  : import(new URL("../lib/app.mjs", import.meta.url).href)).catch((error) => {
  // A failure reads as one line, never a stack trace. With no message, name the code or error type.
  const kind = [error?.code, error?.name].find((value) => value && value !== "Error");
  const text = String(error?.stderr ?? error?.message ?? (typeof error === "string" ? error : "")).trim().split("\n").filter(Boolean).pop() ?? `unknown error${kind ? ` (${kind})` : ""}`;
  console.error(text.startsWith("Failed") ? text : `Failed: ${text}`);
  process.exit(1);
});
